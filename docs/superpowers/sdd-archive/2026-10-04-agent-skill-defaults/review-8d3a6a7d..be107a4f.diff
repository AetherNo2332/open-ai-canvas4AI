+	enabled, err := repo.EnabledAgentSkillDefaults()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(enabled) != 3 {
+		t.Fatalf("enabled rows = %d, want 3", len(enabled))
+	}
+	if enabled[0].SkillID != "skill-a" || enabled[2].SkillID != "skill-c" {
+		t.Fatalf("enabled 排序错误：%#v", enabled)
+	}
+}
